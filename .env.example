# ── Bright Data ─────────────────────────────────────────────────────────────
# Get your API key at: https://brightdata.com → Account → API
# Create a "Web Unlocker" zone named "web_unlocker1"
BRIGHTDATA_API_KEY=your_brightdata_api_key_here

# ── AgentField ───────────────────────────────────────────────────────────────
# Primary LLM orchestration layer for car summaries
AGENTFIELD_API_KEY=your_agentfield_api_key_here
AGENTFIELD_URL=https://api.agentfield.com/v1/chat/completions

# ── TokenRouter (fallback LLM) ──────────────────────────────────────────────
# Alternative LLM routing for car summaries
TOKENROUTER_API_KEY=your_tokenrouter_api_key_here
TOKENROUTER_URL=https://api.tokenrouter.com/v1/chat/completions

# ── LLM Model ───────────────────────────────────────────────────────────────
# Model to use for generating car summaries (default: qwen-plus)
LLM_MODEL=qwen-plus
